# ekonomikocu — ornek ortam degiskenleri
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun.
# .env dosyasi GIZLIDIR, asla commit etmeyin (bkz. .gitignore).

# --- Grafik vision okuma (opsiyonel) ---
# 99_BOT_ARSIV/kod/enrichment/grafik_vision_oku.py tarafindan kullanilir.
# Bos birakilirsa vision zenginlestirme atlanir, tarama yine calisir.
OPENAI_API_KEY=
# Kullanilacak vision modeli (varsayilan: gpt-4o-mini)
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Bot otomasyon kontrolleri (opsiyonel) ---
# abone_tamamla.py otomatik yeniden baslatma sayisi (varsayilan: 0 = kapali)
ABONE_AUTO_RESTART=0
# bot_yeniden_baslat.py icin pipeline dosya yolu (bos = varsayilan yol)
EKO_BOT_PIPELINE=

# Not: LOCALAPPDATA, ProgramFiles gibi degiskenler Windows tarafindan
# saglanir; buraya yazmaniza gerek yoktur.
# Not: GitHub'a push (github_guncelle.py) git kimlik bilgilerini kullanir,
# burada token tutulmaz.
