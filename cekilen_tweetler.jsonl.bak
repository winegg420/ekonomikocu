{"tweet_id": "2064780185170264161", "datetime": "2026-06-10T21:42:12", "date_label": "10 Haz 21:42", "locked": false, "text": "Böyle balon göze batıyor.\n\nÖrnek; #NASDAQ 30600 #xauusd \noran 6.8 borsa ideal değer.\n\nAma şu; #nasdaq 28 k #XAUUSD 4100 \noran 7 bölgesini yukarı zorluyor.\n\n30600 de normal gelen #ALTIN düştüğü için\npahalılaşıyor.", "products": ["GUMUS_PETROL", "GENEL"], "tip": ["seviye", "tez"], "kayit_tipi": "abone", "lang": "tr", "analyzed": true, "is_quote": false, "quoted_by": null, "quote_of": null, "quote_stub": false, "thread_root": null, "fiyat": "—", "sonra": "—", "sonuc": "yorum", "baglanti": "", "media_urls": [], "media_files": [], "abone_metin": true, "abone_donemi": true, "abone_ozel": true}
