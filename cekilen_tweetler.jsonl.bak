{"tweet_id": "2051399695239389642", "datetime": "2026-05-04T23:32:55", "date_label": "4 May 23:32", "locked": false, "text": "Ben uzun zamandır #ALTIN işlem almıyorum,\nbakmadım swaplara.\n\nAma satış işlemleri eksi swap olduysa,\naşağı baskı işlerine gelmiyordur.\n\nNasdaq da ise ben swap ödemiyorum,\nsadece komisyon.", "products": ["GUMUS_PETROL", "GENEL"], "tip": ["yorum"], "kayit_tipi": "yorum", "lang": "tr", "analyzed": true, "is_quote": false, "quoted_by": null, "quote_of": null, "quote_stub": false, "thread_root": null, "fiyat": "—", "sonra": "—", "sonuc": "yorum", "baglanti": "", "media_urls": [], "media_files": [], "abone_metin": false, "abone_donemi": true, "abone_ozel": false}
