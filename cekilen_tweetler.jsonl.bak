{"tweet_id": "2063699972382437564", "datetime": "2026-06-07T22:09:49", "date_label": "7 Haz 22:09", "locked": false, "text": "2025 yılında yine aynı görüşteydim\n\nRakip olan ülkeler aslında değil gibiler.\nSadece istediklerini alamadıkları için kapris\nyapıyorlar. Yalandan kapris yapıyorlar.", "products": ["GENEL"], "tip": ["tez"], "kayit_tipi": "abone", "lang": "tr", "analyzed": true, "is_quote": false, "quoted_by": null, "quote_of": null, "quote_stub": false, "thread_root": null, "fiyat": "—", "sonra": "—", "sonuc": "yorum", "baglanti": "", "media_urls": [], "media_files": [], "abone_metin": true, "abone_donemi": true, "abone_ozel": true}
