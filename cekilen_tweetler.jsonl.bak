{"tweet_id": "2066574509264515098", "datetime": "2026-06-15T20:32:12", "date_label": "15 Haz 20:32", "locked": false, "text": "Bu grafikte mumlar aşağı geliyorsa;\n\n1- Ya #sp500 düşüyordur.\n2- Ya da #ETH güçleniyordur.\n\nBu adamlar olaya nasıl bakıyorlar ?\n\n#ETH borsayı senelerce ezmiş gözü ile bakıyor.", "products": ["GENEL"], "tip": ["yorum"], "kayit_tipi": "abone", "lang": "tr", "analyzed": true, "is_quote": false, "quoted_by": null, "quote_of": null, "quote_stub": false, "thread_root": null, "fiyat": "—", "sonra": "—", "sonuc": "yorum", "baglanti": "", "media_urls": [], "media_files": [], "abone_metin": true, "abone_donemi": true, "abone_ozel": true}
