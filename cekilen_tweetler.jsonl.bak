{"tweet_id": "2059039473279827975", "datetime": "2026-05-26T01:30:40", "date_label": "26 May 01:30", "locked": false, "text": "Adamlar hafta başlarken ne yapıyorlar ?\nDirekt 29700 üstüne #gapli açılış yapıyorlar.\n\nHemen msjı alacaksın.\n\n29700 üstünde kaldıkça düşüşe izin vermezler.\nVermek istemedikleri için #gapli fiyatı oranın üstüne\nçıkartıyorlar.", "products": ["GENEL"], "tip": ["seviye", "tez"], "kayit_tipi": "abone", "lang": "tr", "analyzed": true, "is_quote": false, "quoted_by": null, "quote_of": null, "quote_stub": false, "thread_root": null, "fiyat": "DOĞRULANACAK (web)", "sonra": "—", "sonuc": "izleniyor", "baglanti": "", "media_urls": ["https://pbs.twimg.com/media/HJMtOCnXYAASldk?format=jpg&name=large"], "media_files": ["medya/2059039473279827975/graf_01.jpg"], "abone_metin": true, "abone_donemi": true, "abone_ozel": true}
